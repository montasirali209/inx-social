# INX Social Desktop configuration

# Local development backend
INX_API_URL=http://localhost:5050

# Production backend
# INX_API_URL=https://api.social.inaxx.co.uk

# Desktop scheduler defaults
VIDEOS_DIR=./videos
CAPTIONS_DIR=./captions
STATE_PATH=./data/schedule-state.json

TIMEZONE=Europe/London
SCHEDULE_TIMES=11:00,15:13,22:15,23:15

BATCH_DELAY_MS=3000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=5000

# Optional scheduling safety limit
MAX_SCHEDULE_DAYS=25
MIN_LEAD_MINUTES=20