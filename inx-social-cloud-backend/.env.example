PORT=5050
NODE_ENV=development
# Local development values. In Railway production set both to:
# https://social.inaxx.co.uk
APP_URL=http://localhost:5050
PORTAL_URL=http://localhost:5050
DATABASE_URL="postgresql://inx_social:change-me@localhost:5432/inx_social?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
DEFAULT_TRIAL_DAYS=5
TOKEN_ENCRYPTION_KEY="replace-with-an-independent-long-random-secret"
FB_GRAPH_VERSION=v25.0

ADMIN_EMAIL="admin@inxsocial.local"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="INX Social Admin"

# SMTP transactional email
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=no-reply@inaxx.co.uk
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM="INX Social <no-reply@inaxx.co.uk>"
EMAIL_REPLY_TO=contact@inaxx.co.uk

# Stripe Billing (use test keys first)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# In Railway production use the same paths on https://social.inaxx.co.uk.
STRIPE_SUCCESS_URL=http://localhost:5050/portal/?checkout=success
STRIPE_CANCEL_URL=http://localhost:5050/portal/?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:5050/portal/
PAYMENT_GRACE_DAYS=7

# Legacy installer fallback. Tagged GitHub releases are stored in DesktopRelease instead.
LATEST_DESKTOP_VERSION=14.0.2
INSTALLER_URL=
# Keep this stable in Railway and copy the same value to the GitHub
# production-release environment secret named RELEASE_API_KEY.
RELEASE_API_KEY="replace-with-a-long-random-secret"
# Social Agent brain (Ollama first)
# Local backend: http://127.0.0.1:11434
# Railway must use a private Ollama service or authenticated HTTPS tunnel.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_SIMPLE_CONTEXT=8192
OLLAMA_COMPLEX_CONTEXT=32768
OLLAMA_VISION_ENABLED=true
OLLAMA_IMAGE_MODEL=x/z-image-turbo
OLLAMA_QUALITY_IMAGE_MODEL=x/flux2-klein:4b
OLLAMA_IMAGE_TIMEOUT_MS=300000
OLLAMA_IMAGE_REVIEW_ENABLED=true
OLLAMA_IMAGE_REVIEW_MIN_SCORE=75
OLLAMA_API_KEY=
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=
OLLAMA_TIMEOUT_MS=180000
OLLAMA_TASK_TIMEOUT_MS=330000

# Optional emergency fallback. It is OFF unless explicitly enabled and is called
# only for an Ollama network/timeout/429/5xx availability failure.
AI_PAID_FALLBACK_ENABLED=false
AI_PAID_FALLBACK_BASE_URL=https://api.openai.com/v1
AI_PAID_FALLBACK_MODEL=
AI_PAID_FALLBACK_MAX_CALLS_PER_MISSION=1

# User-initiated Posts caption enhancement. These values fall back to the
# corresponding OpenAI / paid-fallback values when left empty.
POST_ENHANCEMENT_ENABLED=true
POST_ENHANCEMENT_BASE_URL=
POST_ENHANCEMENT_API_KEY=
POST_ENHANCEMENT_MODEL=
POST_ENHANCEMENT_TIMEOUT_MS=60000

# One OpenAI key supports the governed live-web refinement and, only when the
# independent fallback switch is enabled, emergency paid fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_WEB_SEARCH_MODEL=gpt-5.6-terra

# Governed paid image generation. This is controlled independently from
# AI_PAID_FALLBACK_ENABLED by the administrator's Image Generation policy.
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TIMEOUT_MS=300000

# Complex research sequence: Ollama first draft -> OpenAI Responses web_search
# and evidence refinement -> administrator-reviewed reusable learning.
WEB_RESEARCH_ENABLED=false
WEB_RESEARCH_PROVIDER=openai
WEB_RESEARCH_BASE_URL=https://api.openai.com/v1
WEB_RESEARCH_TIMEOUT_MS=120000
WEB_RESEARCH_MAX_SOURCES=8
WEB_RESEARCH_MAX_QUERIES=3
WEB_RESEARCH_COUNTRY=GB
WEB_RESEARCH_LANGUAGE=en
