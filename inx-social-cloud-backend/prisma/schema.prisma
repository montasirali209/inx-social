generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  businessName     String?
  email            String    @unique
  passwordHash     String
  role             String    @default("USER")
  status           String    @default("PENDING_VERIFICATION")
  trialEndsAt      DateTime?
  emailVerifiedAt  DateTime?
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subscriptions           Subscription[]
  devices                 Device[]
  metaAccounts            MetaAccount[]
  connectedPages          ConnectedPage[]
  scheduleJobs            ScheduleJob[]
  cloudAssets             CloudAsset[]
  cloudPreference         CloudPreference?
  auditLogs               AuditLog[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailLogs               EmailLog[]
  downloadHistory         DownloadHistory[]
  agentPlans              AgentPlan[]
  agentMemories           AgentMemory[]
  agentEvents             AgentEvent[]
  agentAssets             AgentAsset[]
  mediaFolders            MediaFolder[]
  agentCampaigns          AgentCampaign[]
  socialConnections       SocialConnection[]
  socialProfiles          SocialProfile[]
  socialContents          SocialContent[]

  @@index([status])
  @@index([role])
  @@index([createdAt])
}

model AgentPlan {
  id                 String    @id @default(cuid())
  userId             String
  prompt             String
  status             String    @default("AWAITING_APPROVAL")
  platformsJson      String
  strategyJson       String
  estimatedCostCents Int       @default(0)
  operationMode      String    @default("HYBRID")
  approvedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks    AgentTask[]
  events   AgentEvent[]
  assets   AgentAsset[]
  campaign AgentCampaign?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AgentAsset {
  id                String    @id @default(cuid())
  userId            String
  planId            String?
  kind              String
  source            String    @default("UPLOAD")
  status            String    @default("READY")
  originalName      String?
  mimeType          String
  byteSize          Int
  checksum          String
  prompt            String?
  customerPrompt    String?
  exactOverlayText  String?
  generationChoice  String?
  qualityScore      Int?
  qualityIssuesJson String?
  data              Bytes
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  folderId          String?
  tagsJson          String    @default("[]")
  width             Int?
  height            Int?
  durationSeconds   Int?
  archivedAt        DateTime?

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          AgentPlan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  campaignPosts AgentCampaignPost[]
  folder        MediaFolder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([planId])
  @@index([checksum])
  @@index([expiresAt])
  @@index([folderId])
  @@index([userId, status, source])
}

model MediaFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets AgentAsset[]

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model AgentTask {
  id                 String    @id @default(cuid())
  planId             String
  sequence           Int
  type               String
  platform           String?
  title              String
  description        String
  status             String    @default("PLANNED")
  riskLevel          String    @default("LOW")
  executionMode      String    @default("INX_TEMPLATE")
  estimatedCostCents Int       @default(0)
  outputJson         String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  plan AgentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sequence])
  @@index([planId])
  @@index([status])
  @@index([type])
}

model AgentMemory {
  id             String    @id @default(cuid())
  userId         String
  pageId         String?
  category       String
  title          String
  content        String
  source         String    @default("AGENT")
  confidence     Int       @default(80)
  approvalStatus String    @default("PENDING_REVIEW")
  importance     String    @default("ROUTINE")
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pageId])
  @@index([category])
  @@index([approvalStatus])
  @@index([importance])
  @@index([updatedAt])
}

model AgentEvent {
  id           String   @id @default(cuid())
  userId       String
  planId       String?
  taskId       String?
  type         String
  status       String   @default("INFO")
  title        String
  message      String
  metadataJson String?
  createdAt    DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan AgentPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@index([taskId])
  @@index([createdAt])
}

model Subscription {
  id                  String    @id @default(cuid())
  userId              String
  plan                String    @default("TRIAL")
  status              String    @default("TRIALING")
  provider            String?
  providerCustomerId  String?
  providerSubId       String?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  graceEndsAt         DateTime?
  lastPaymentFailedAt DateTime?
  cancelAtPeriodEnd   Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([plan])
  @@index([status])
  @@index([providerSubId])
  @@index([providerCustomerId])
}

model Device {
  id         String    @id @default(cuid())
  userId     String
  deviceName String?
  deviceId   String
  appVersion String?
  status     String    @default("ACTIVE")
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([status])
  @@index([lastSeenAt])
}

model MetaAccount {
  id                   String    @id @default(cuid())
  userId               String
  facebookUserId       String
  facebookUserName     String?
  facebookProfileImage String?
  encryptedAccessToken String
  tokenExpiresAt       DateTime?
  status               String    @default("ACTIVE")
  connectedAt          DateTime  @default(now())
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages ConnectedPage[]

  @@unique([userId, facebookUserId])
  @@index([userId])
  @@index([facebookUserId])
  @@index([status])
  @@index([tokenExpiresAt])
}

model ConnectedPage {
  id                   String    @id @default(cuid())
  userId               String
  metaAccountId        String?
  facebookPageId       String
  facebookPageName     String
  facebookPageUsername String?
  facebookPagePicture  String?
  facebookCategory     String?
  metaAppId            String?
  status               String    @default("ACTIVE")
  isSelected           Boolean   @default(false)
  encryptedAccessToken String?
  tokenExpiresAt       DateTime?
  connectedAt          DateTime  @default(now())
  lastCheckedAt        DateTime?
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  metaAccount   MetaAccount?        @relation(fields: [metaAccountId], references: [id], onDelete: SetNull)
  scheduleJobs  ScheduleJob[]
  campaignPosts AgentCampaignPost[]

  @@unique([userId, facebookPageId])
  @@index([userId])
  @@index([metaAccountId])
  @@index([facebookPageId])
  @@index([status])
  @@index([isSelected])
  @@index([tokenExpiresAt])
}

// Platform-neutral foundation. Existing Facebook tables remain the live
// publishing path until each official connector is migrated and verified.
model SocialConnection {
  id                    String    @id @default(cuid())
  userId                String
  platform              String
  externalAccountId     String
  accountType           String    @default("BUSINESS")
  displayName           String?
  status                String    @default("PENDING")
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  scopesJson            String?
  metadataJson          String?
  connectedAt           DateTime  @default(now())
  lastSyncedAt          DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profiles SocialProfile[]

  @@unique([userId, platform, externalAccountId])
  @@index([userId, platform])
  @@index([status])
  @@index([tokenExpiresAt])
}

model SocialProfile {
  id                String   @id @default(cuid())
  userId            String
  connectionId      String
  platform          String
  externalProfileId String
  displayName       String
  username          String?
  profileType       String   @default("PAGE")
  avatarUrl         String?
  status            String   @default("ACTIVE")
  isDefault         Boolean  @default(false)
  capabilitiesJson  String?
  metadataJson      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   SocialConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  publications SocialPublication[]

  @@unique([connectionId, externalProfileId])
  @@index([userId, platform])
  @@index([status])
  @@index([isDefault])
}

model SocialContent {
  id             String   @id @default(cuid())
  userId         String
  title          String?
  caption        String?
  altText        String?
  status         String   @default("DRAFT")
  approvalStatus String   @default("NOT_REQUIRED")
  source         String   @default("MANUAL")
  sourcePlanId   String?
  timezone       String   @default("Europe/London")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  publications SocialPublication[]

  @@index([userId, status])
  @@index([approvalStatus])
  @@index([sourcePlanId])
  @@index([createdAt])
}

model SocialPublication {
  id              String    @id @default(cuid())
  contentId       String
  profileId       String
  platform        String
  status          String    @default("DRAFT")
  platformCaption String?
  platformAltText String?
  mediaJson       String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  externalPostId  String?
  idempotencyKey  String?
  attemptCount    Int       @default(0)
  lastAttemptAt   DateTime?
  lastError       String?
  metricsJson     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  content SocialContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, idempotencyKey])
  @@index([contentId, status])
  @@index([profileId, scheduledAt])
  @@index([platform, status])
  @@index([externalPostId])
}

model ScheduleJob {
  id              String    @id @default(cuid())
  userId          String
  connectedPageId String?
  status          String    @default("DRAFT")
  origin          String    @default("DESKTOP")
  uploadStatus    String    @default("NOT_REQUIRED")
  publishMode     String    @default("SCHEDULED")
  clientRequestId String?
  contentType     String
  title           String?
  caption         String?
  localFileName   String?
  scheduledAt     DateTime?
  attemptCount    Int       @default(0)
  nextAttemptAt   DateTime?
  claimedAt       DateTime?
  completedAt     DateTime?
  metaPostId      String?
  metaVideoId     String?
  errorMessage    String?
  rawMetaResponse String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedPage ConnectedPage?     @relation(fields: [connectedPageId], references: [id], onDelete: SetNull)
  cloudAsset    CloudAsset?
  campaignPost  AgentCampaignPost?

  @@unique([userId, clientRequestId])
  @@index([userId])
  @@index([connectedPageId])
  @@index([status])
  @@index([origin])
  @@index([uploadStatus])
  @@index([scheduledAt])
  @@index([nextAttemptAt])
  @@index([contentType])
}

model AgentCampaign {
  id                String    @id @default(cuid())
  userId            String
  planId            String    @unique
  name              String
  status            String    @default("DRAFT")
  targetPageIdsJson String
  timezone          String    @default("Europe/London")
  researchSummary   String?
  approvedAt        DateTime?
  scheduledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan  AgentPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  posts AgentCampaignPost[]

  @@index([userId, createdAt])
  @@index([status])
}

model AgentCampaignPost {
  id              String    @id @default(cuid())
  campaignId      String
  connectedPageId String?
  assetId         String?
  scheduleJobId   String?   @unique
  sequence        Int
  status          String    @default("READY_FOR_REVIEW")
  platform        String    @default("facebook")
  format          String    @default("IMAGE")
  title           String?
  caption         String
  altText         String?
  hashtagsJson    String?
  visualBrief     String?
  scheduledAt     DateTime?
  scheduleReason  String?
  approvedAt      DateTime?
  metaPostId      String?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaign      AgentCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  connectedPage ConnectedPage? @relation(fields: [connectedPageId], references: [id], onDelete: SetNull)
  asset         AgentAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  scheduleJob   ScheduleJob?   @relation(fields: [scheduleJobId], references: [id], onDelete: SetNull)

  @@unique([campaignId, sequence])
  @@index([campaignId, status])
  @@index([connectedPageId])
  @@index([assetId])
  @@index([scheduledAt])
}

model CloudAsset {
  id               String    @id @default(cuid())
  userId           String
  scheduleJobId    String    @unique
  provider         String    @default("UNCONFIGURED")
  storageKey       String?   @unique
  originalFileName String
  mimeType         String?
  fileSizeBytes    BigInt?
  sha256           String?
  status           String    @default("AWAITING_UPLOAD")
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleJob ScheduleJob @relation(fields: [scheduleJobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model CloudPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  settingsJson String?
  uiTextsJson  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailLog {
  id           String   @id @default(cuid())
  userId       String?
  type         String
  recipient    String
  subject      String
  status       String   @default("QUEUED")
  providerId   String?
  errorMessage String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model DownloadHistory {
  id        String   @id @default(cuid())
  userId    String
  version   String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([version])
  @@index([createdAt])
}

model BillingEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String    @unique
  eventType       String
  status          String    @default("RECEIVED")
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([provider])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model DesktopRelease {
  id                      String   @id @default(cuid())
  version                 String   @unique
  fileName                String
  storageKey              String   @unique
  fileSizeBytes           BigInt
  sha256                  String
  releaseNotes            String?
  minimumSupportedVersion String?
  mandatory               Boolean  @default(false)
  active                  Boolean  @default(true)
  downloadCount           Int      @default(0)
  publishedAt             DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([active, publishedAt])
}
