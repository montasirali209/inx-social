generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  businessName     String?
  email            String    @unique
  passwordHash     String
  role             String    @default("USER")
  status           String    @default("PENDING_VERIFICATION")
  trialEndsAt      DateTime?
  emailVerifiedAt  DateTime?
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subscriptions           Subscription[]
  devices                 Device[]
  metaAccounts            MetaAccount[]
  connectedPages          ConnectedPage[]
  scheduleJobs            ScheduleJob[]
  cloudAssets             CloudAsset[]
  cloudPreference         CloudPreference?
  auditLogs               AuditLog[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailLogs               EmailLog[]
  downloadHistory         DownloadHistory[]
  agentPlans              AgentPlan[]
  agentMemories           AgentMemory[]
  agentEvents             AgentEvent[]

  @@index([status])
  @@index([role])
  @@index([createdAt])
}

model AgentPlan {
  id                 String    @id @default(cuid())
  userId             String
  prompt             String
  status             String    @default("AWAITING_APPROVAL")
  platformsJson      String
  strategyJson       String
  estimatedCostCents Int       @default(0)
  operationMode      String    @default("HYBRID")
  approvedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  AgentTask[]
  events AgentEvent[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AgentTask {
  id                 String   @id @default(cuid())
  planId             String
  sequence           Int
  type               String
  platform           String?
  title              String
  description        String
  status             String   @default("PLANNED")
  riskLevel          String   @default("LOW")
  executionMode      String   @default("INX_TEMPLATE")
  estimatedCostCents Int      @default(0)
  outputJson         String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  plan AgentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sequence])
  @@index([planId])
  @@index([status])
  @@index([type])
}

model AgentMemory {
  id         String   @id @default(cuid())
  userId     String
  pageId     String?
  category   String
  title      String
  content    String
  source     String   @default("AGENT")
  confidence Int      @default(80)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pageId])
  @@index([category])
  @@index([updatedAt])
}

model AgentEvent {
  id          String   @id @default(cuid())
  userId      String
  planId      String?
  taskId      String?
  type        String
  status      String   @default("INFO")
  title       String
  message     String
  metadataJson String?
  createdAt   DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan AgentPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@index([taskId])
  @@index([createdAt])
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  plan               String    @default("TRIAL")
  status             String    @default("TRIALING")
  provider           String?
  providerCustomerId String?
  providerSubId      String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceEndsAt        DateTime?
  lastPaymentFailedAt DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([plan])
  @@index([status])
  @@index([providerSubId])
  @@index([providerCustomerId])
}

model Device {
  id         String    @id @default(cuid())
  userId     String
  deviceName String?
  deviceId   String
  appVersion String?
  status     String    @default("ACTIVE")
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([status])
  @@index([lastSeenAt])
}

model MetaAccount {
  id                   String    @id @default(cuid())
  userId               String
  facebookUserId       String
  facebookUserName     String?
  facebookProfileImage String?
  encryptedAccessToken String
  tokenExpiresAt       DateTime?
  status               String    @default("ACTIVE")
  connectedAt          DateTime  @default(now())
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages ConnectedPage[]

  @@unique([userId, facebookUserId])
  @@index([userId])
  @@index([facebookUserId])
  @@index([status])
  @@index([tokenExpiresAt])
}

model ConnectedPage {
  id                   String    @id @default(cuid())
  userId               String
  metaAccountId        String?
  facebookPageId       String
  facebookPageName     String
  facebookPageUsername String?
  facebookPagePicture  String?
  facebookCategory     String?
  metaAppId            String?
  status               String    @default("ACTIVE")
  isSelected           Boolean   @default(false)
  encryptedAccessToken String?
  tokenExpiresAt       DateTime?
  connectedAt          DateTime  @default(now())
  lastCheckedAt        DateTime?
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  metaAccount  MetaAccount?  @relation(fields: [metaAccountId], references: [id], onDelete: SetNull)
  scheduleJobs ScheduleJob[]

  @@unique([userId, facebookPageId])
  @@index([userId])
  @@index([metaAccountId])
  @@index([facebookPageId])
  @@index([status])
  @@index([isSelected])
  @@index([tokenExpiresAt])
}

model ScheduleJob {
  id              String    @id @default(cuid())
  userId          String
  connectedPageId String?
  status          String    @default("DRAFT")
  origin          String    @default("DESKTOP")
  uploadStatus    String    @default("NOT_REQUIRED")
  publishMode     String    @default("SCHEDULED")
  clientRequestId String?
  contentType     String
  title           String?
  caption         String?
  localFileName   String?
  scheduledAt     DateTime?
  attemptCount    Int       @default(0)
  nextAttemptAt   DateTime?
  claimedAt       DateTime?
  completedAt     DateTime?
  metaPostId      String?
  metaVideoId     String?
  errorMessage    String?
  rawMetaResponse String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedPage ConnectedPage? @relation(fields: [connectedPageId], references: [id], onDelete: SetNull)
  cloudAsset    CloudAsset?

  @@unique([userId, clientRequestId])
  @@index([userId])
  @@index([connectedPageId])
  @@index([status])
  @@index([origin])
  @@index([uploadStatus])
  @@index([scheduledAt])
  @@index([nextAttemptAt])
  @@index([contentType])
}

model CloudAsset {
  id               String    @id @default(cuid())
  userId           String
  scheduleJobId    String    @unique
  provider         String    @default("UNCONFIGURED")
  storageKey       String?   @unique
  originalFileName String
  mimeType         String?
  fileSizeBytes    BigInt?
  sha256           String?
  status           String    @default("AWAITING_UPLOAD")
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleJob ScheduleJob @relation(fields: [scheduleJobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model CloudPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  settingsJson String?
  uiTextsJson  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailLog {
  id           String   @id @default(cuid())
  userId       String?
  type         String
  recipient    String
  subject      String
  status       String   @default("QUEUED")
  providerId   String?
  errorMessage String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model DownloadHistory {
  id        String   @id @default(cuid())
  userId    String
  version   String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([version])
  @@index([createdAt])
}

model BillingEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String    @unique
  eventType       String
  status          String    @default("RECEIVED")
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([provider])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model DesktopRelease {
  id                      String   @id @default(cuid())
  version                 String   @unique
  fileName                String
  storageKey              String   @unique
  fileSizeBytes           BigInt
  sha256                  String
  releaseNotes            String?
  minimumSupportedVersion String?
  mandatory               Boolean  @default(false)
  active                  Boolean  @default(true)
  downloadCount           Int      @default(0)
  publishedAt             DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([active, publishedAt])
}
