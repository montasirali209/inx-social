generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  businessName     String?
  email            String    @unique
  passwordHash     String
  role             String    @default("USER")
  status           String    @default("PENDING_VERIFICATION")
  trialEndsAt      DateTime?
  emailVerifiedAt  DateTime?
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subscriptions           Subscription[]
  devices                 Device[]
  metaAccounts            MetaAccount[]
  connectedPages          ConnectedPage[]
  scheduleJobs            ScheduleJob[]
  cloudAssets             CloudAsset[]
  cloudPreference         CloudPreference?
  auditLogs               AuditLog[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailLogs               EmailLog[]
  downloadHistory         DownloadHistory[]
  agentPlans              AgentPlan[]
  agentMemories           AgentMemory[]
  agentEvents             AgentEvent[]
  agentAssets             AgentAsset[]
  mediaFolders            MediaFolder[]
  agentCampaigns          AgentCampaign[]
  socialConnections       SocialConnection[]
  socialProfiles          SocialProfile[]
  socialContents          SocialContent[]
  aiPostCampaigns         AiPostCampaign[]

  @@index([status])
  @@index([role])
  @@index([createdAt])
}

model AgentPlan {
  id                 String    @id @default(cuid())
  userId             String
  prompt             String
  status             String    @default("AWAITING_APPROVAL")
  platformsJson      String
  strategyJson       String
  estimatedCostCents Int       @default(0)
  operationMode      String    @default("HYBRID")
  approvedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks    AgentTask[]
  events   AgentEvent[]
  assets   AgentAsset[]
  campaign AgentCampaign?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AgentAsset {
  id                String    @id @default(cuid())
  userId            String
  planId            String?
  kind              String
  source            String    @default("UPLOAD")
  status            String    @default("READY")
  originalName      String?
  mimeType          String
  byteSize          Int
  checksum          String
  prompt            String?
  customerPrompt    String?
  exactOverlayText  String?
  generationChoice  String?
  qualityScore      Int?
  qualityIssuesJson String?
  data              Bytes?
  storageProvider   String    @default("DATABASE")
  storageKey        String?   @unique
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  folderId          String?
  tagsJson          String    @default("[]")
  width             Int?
  height            Int?
  durationSeconds   Int?
  archivedAt        DateTime?

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          AgentPlan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  campaignPosts AgentCampaignPost[]
  scheduleJobs  ScheduleJob[]
  folder        MediaFolder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([planId])
  @@index([checksum])
  @@index([expiresAt])
  @@index([folderId])
  @@index([userId, status, source])
  @@index([storageProvider])
}

model MediaFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets AgentAsset[]

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model AgentTask {
  id                 String    @id @default(cuid())
  planId             String
  sequence           Int
  type               String
  platform           String?
  title              String
  description        String
  status             String    @default("PLANNED")
  riskLevel          String    @default("LOW")
  executionMode      String    @default("INX_TEMPLATE")
  estimatedCostCents Int       @default(0)
  outputJson         String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  plan AgentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sequence])
  @@index([planId])
  @@index([status])
  @@index([type])
}

model AgentMemory {
  id             String    @id @default(cuid())
  userId         String
  pageId         String?
  category       String
  title          String
  content        String
  source         String    @default("AGENT")
  confidence     Int       @default(80)
  approvalStatus String    @default("PENDING_REVIEW")
  importance     String    @default("ROUTINE")
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pageId])
  @@index([category])
  @@index([approvalStatus])
  @@index([importance])
  @@index([updatedAt])
}

model AgentEvent {
  id           String   @id @default(cuid())
  userId       String
  planId       String?
  taskId       String?
  type         String
  status       String   @default("INFO")
  title        String
  message      String
  metadataJson String?
  createdAt    DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan AgentPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@index([taskId])
  @@index([createdAt])
}

model Subscription {
  id                  String    @id @default(cuid())
  userId              String
  plan                String    @default("TRIAL")
  status              String    @default("TRIALING")
  provider            String?
  providerCustomerId  String?
  providerSubId       String?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  graceEndsAt         DateTime?
  lastPaymentFailedAt DateTime?
  cancelAtPeriodEnd   Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([plan])
  @@index([status])
  @@index([providerSubId])
  @@index([providerCustomerId])
}

model Device {
  id         String    @id @default(cuid())
  userId     String
  deviceName String?
  deviceId   String
  appVersion String?
  status     String    @default("ACTIVE")
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([status])
  @@index([lastSeenAt])
}

model MetaAccount {
  id                   String    @id @default(cuid())
  userId               String
  facebookUserId       String
  facebookUserName     String?
  facebookProfileImage String?
  encryptedAccessToken String
  tokenExpiresAt       DateTime?
  status               String    @default("ACTIVE")
  connectedAt          DateTime  @default(now())
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages ConnectedPage[]

  @@unique([userId, facebookUserId])
  @@index([userId])
  @@index([facebookUserId])
  @@index([status])
  @@index([tokenExpiresAt])
}

model ConnectedPage {
  id                   String    @id @default(cuid())
  userId               String
  metaAccountId        String?
  facebookPageId       String
  facebookPageName     String
  facebookPageUsername String?
  facebookPagePicture  String?
  facebookCategory     String?
  metaAppId            String?
  status               String    @default("ACTIVE")
  isSelected           Boolean   @default(false)
  encryptedAccessToken String?
  tokenExpiresAt       DateTime?
  connectedAt          DateTime  @default(now())
  lastCheckedAt        DateTime?
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  metaAccount   MetaAccount?        @relation(fields: [metaAccountId], references: [id], onDelete: SetNull)
  scheduleJobs  ScheduleJob[]
  campaignPosts AgentCampaignPost[]

  @@unique([userId, facebookPageId])
  @@index([userId])
  @@index([metaAccountId])
  @@index([facebookPageId])
  @@index([status])
  @@index([isSelected])
  @@index([tokenExpiresAt])
}

// Platform-neutral foundation. Existing Facebook tables remain the live
// publishing path until each official connector is migrated and verified.
model SocialConnection {
  id                    String    @id @default(cuid())
  userId                String
  platform              String
  externalAccountId     String
  accountType           String    @default("BUSINESS")
  displayName           String?
  status                String    @default("PENDING")
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  scopesJson            String?
  metadataJson          String?
  connectedAt           DateTime  @default(now())
  lastSyncedAt          DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profiles SocialProfile[]

  @@unique([userId, platform, externalAccountId])
  @@index([userId, platform])
  @@index([status])
  @@index([tokenExpiresAt])
}

model SocialProfile {
  id                String   @id @default(cuid())
  userId            String
  connectionId      String
  platform          String
  externalProfileId String
  displayName       String
  username          String?
  profileType       String   @default("PAGE")
  avatarUrl         String?
  status            String   @default("ACTIVE")
  isDefault         Boolean  @default(false)
  capabilitiesJson  String?
  metadataJson      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   SocialConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  publications      SocialPublication[]
  analyticsSnapshots AnalyticsMetricSnapshot[]
  analyticsCaches    AnalyticsSourceCache[]

  @@unique([connectionId, externalProfileId])
  @@index([userId, platform])
  @@index([status])
  @@index([isDefault])
}

model SocialContent {
  id             String   @id @default(cuid())
  userId         String
  title          String?
  caption        String?
  altText        String?
  status         String   @default("DRAFT")
  approvalStatus String   @default("NOT_REQUIRED")
  source         String   @default("MANUAL")
  sourcePlanId   String?
  timezone       String   @default("Europe/London")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  publications SocialPublication[]

  @@index([userId, status])
  @@index([approvalStatus])
  @@index([sourcePlanId])
  @@index([createdAt])
}

model SocialPublication {
  id              String    @id @default(cuid())
  contentId       String
  profileId       String
  platform        String
  status          String    @default("DRAFT")
  platformCaption String?
  platformAltText String?
  mediaJson       String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  externalPostId  String?
  idempotencyKey  String?
  attemptCount    Int       @default(0)
  lastAttemptAt   DateTime?
  lastError       String?
  metricsJson     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  content SocialContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, idempotencyKey])
  @@index([contentId, status])
  @@index([profileId, scheduledAt])
  @@index([platform, status])
  @@index([externalPostId])
}

model AiPostCampaign {
  id             String   @id @default(cuid())
  userId         String
  title          String
  businessUrl    String?
  goal           String
  audience       String?
  tone           String?
  contentMode    String   @default("TEXT")
  platformsJson  String   @default("[]")
  postCount      Int
  imagePostCount Int      @default(0)
  status         String   @default("READY")
  analysisJson   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts AiPostCampaignPost[]

  @@index([userId, createdAt])
  @@index([status])
}

model AiPostCampaignPost {
  id             String   @id @default(cuid())
  campaignId     String
  sequence       Int
  status         String   @default("READY")
  contentType    String   @default("TEXT")
  title          String
  pillar         String?
  hook           String?
  caption        String
  cta            String?
  hashtagsJson   String   @default("[]")
  imageBrief     String?
  mediaAssetId   String?
  mediaAssetJson String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaign AiPostCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, sequence])
  @@index([campaignId, status])
}

model BulkCancellationJob {
  id                 String    @id @default(cuid())
  userId             String
  publicationIdsJson String
  status             String    @default("QUEUED")
  requestedCount     Int       @default(0)
  cancelledCount     Int       @default(0)
  failedCount        Int       @default(0)
  resultJson         String?
  lastError          String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AnalyticsMetricSnapshot {
  id              String   @id @default(cuid())
  userId          String
  profileId       String
  platform        String
  externalPostId  String
  postPublishedAt DateTime?
  capturedAt      DateTime @default(now())
  views           Int      @default(0)
  interactions    Int      @default(0)
  clicks          Int      @default(0)
  follows         Int      @default(0)
  metricsJson     String?

  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, capturedAt])
  @@index([profileId, externalPostId, capturedAt])
  @@index([userId, capturedAt])
}

model AnalyticsSourceCache {
  id                 String    @id @default(cuid())
  userId             String
  profileId          String
  platform           String
  periodDays         Int
  cacheVariant       String    @default("full")
  payloadJson        String?
  syncStatus         String    @default("EMPTY")
  syncedAt           DateTime?
  refreshRequestedAt DateTime?
  lastAttemptAt      DateTime?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId, periodDays, cacheVariant])
  @@index([profileId, syncedAt])
  @@index([userId, updatedAt])
  @@index([syncStatus, refreshRequestedAt])
}



model ScheduleJob {
  id              String    @id @default(cuid())
  userId          String
  connectedPageId String?
  status          String    @default("DRAFT")
  origin          String    @default("DESKTOP")
  uploadStatus    String    @default("NOT_REQUIRED")
  publishMode     String    @default("SCHEDULED")
  clientRequestId String?
  contentType     String
  title           String?
  caption         String?
  localFileName   String?
  scheduledAt     DateTime?
  attemptCount    Int       @default(0)
  nextAttemptAt   DateTime?
  claimedAt       DateTime?
  completedAt     DateTime?
  metaPostId      String?
  metaVideoId     String?
  errorMessage    String?
  mediaLibraryAssetId String?
  rawMetaResponse String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedPage ConnectedPage?     @relation(fields: [connectedPageId], references: [id], onDelete: SetNull)
  cloudAsset    CloudAsset?
  campaignPost  AgentCampaignPost?
  mediaLibraryAsset AgentAsset?    @relation(fields: [mediaLibraryAssetId], references: [id], onDelete: SetNull)

  @@unique([userId, clientRequestId])
  @@index([userId])
  @@index([connectedPageId])
  @@index([status])
  @@index([origin])
  @@index([uploadStatus])
  @@index([scheduledAt])
  @@index([nextAttemptAt])
  @@index([contentType])
  @@index([mediaLibraryAssetId])
}

model AgentCampaign {
  id                String    @id @default(cuid())
  userId            String
  planId            String    @unique
  name              String
  status            String    @default("DRAFT")
  targetPageIdsJson String
  timezone          String    @default("Europe/London")
  researchSummary   String?
  approvedAt        DateTime?
  scheduledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan  AgentPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  posts AgentCampaignPost[]

  @@index([userId, createdAt])
  @@index([status])
}

model AgentCampaignPost {
  id              String    @id @default(cuid())
  campaignId      String
  connectedPageId String?
  assetId         String?
  scheduleJobId   String?   @unique
  sequence        Int
  status          String    @default("READY_FOR_REVIEW")
  platform        String    @default("facebook")
  format          String    @default("IMAGE")
  title           String?
  caption         String
  altText         String?
  hashtagsJson    String?
  visualBrief     String?
  scheduledAt     DateTime?
  scheduleReason  String?
  approvedAt      DateTime?
  metaPostId      String?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaign      AgentCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  connectedPage ConnectedPage? @relation(fields: [connectedPageId], references: [id], onDelete: SetNull)
  asset         AgentAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  scheduleJob   ScheduleJob?   @relation(fields: [scheduleJobId], references: [id], onDelete: SetNull)

  @@unique([campaignId, sequence])
  @@index([campaignId, status])
  @@index([connectedPageId])
  @@index([assetId])
  @@index([scheduledAt])
}

model CloudAsset {
  id               String    @id @default(cuid())
  userId           String
  scheduleJobId    String    @unique
  provider         String    @default("UNCONFIGURED")
  storageKey       String?   @unique
  originalFileName String
  mimeType         String?
  fileSizeBytes    BigInt?
  sha256           String?
  status           String    @default("AWAITING_UPLOAD")
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleJob ScheduleJob @relation(fields: [scheduleJobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model CloudPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  settingsJson String?
  uiTextsJson  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebsiteMediaAsset {
  id                    String                @id @default(cuid())
  key                   String                @unique
  label                 String
  section               String
  altText               String?
  recommendedMinWidth   Int?
  recommendedMinHeight  Int?
  currentVersionId      String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  currentVersion WebsiteMediaVersion?  @relation("WebsiteMediaCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       WebsiteMediaVersion[] @relation("WebsiteMediaVersions")

  @@index([section])
  @@index([updatedAt])
}

model WebsiteMediaVersion {
  id               String             @id @default(cuid())
  assetId          String
  storageProvider  String
  storageKey       String             @unique
  originalName     String
  mimeType         String
  byteSize         BigInt
  width            Int
  height           Int
  sha256           String
  uploadedByUserId String?
  createdAt        DateTime           @default(now())

  asset      WebsiteMediaAsset   @relation("WebsiteMediaVersions", fields: [assetId], references: [id], onDelete: Cascade)
  currentFor WebsiteMediaAsset[] @relation("WebsiteMediaCurrentVersion")

  @@index([assetId, createdAt])
  @@index([createdAt])
}

model UiDesignProject {
  id              String   @id @default(cuid())
  name            String
  framework       String   @default("REACT_TYPESCRIPT")
  styling         String   @default("TAILWIND")
  outputType      String   @default("SECTION")
  frameworkTargetsJson String   @default("[]")
  stylingTargetsJson   String   @default("[]")
  status               String    @default("ACTIVE")
  bestGenerationId     String?
  acceptedGenerationId String?
  productionGenerationId String?
  bestAggregateScore   Float?
  acceptedAt           DateTime?
  productionGeneratedAt DateTime?
  createdByUserId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  references     UiDesignReference[]
  analyses       UiDesignAnalysis[]
  generations    UiDesignGeneration[]
  renders        UiDesignRender[]
  repairAttempts UiDesignRepairAttempt[]
  assetBindings  UiDesignAssetBinding[]
  ignoreMasks    UiDesignIgnoreMask[]
  deliveries     UiDesignDelivery[]
  agentMessages   UiDesignAgentMessage[]

  @@index([status, updatedAt])
  @@index([createdAt])
}

model UiDesignReference {
  id               String   @id @default(cuid())
  projectId        String
  viewport         String
  storageProvider  String
  storageKey       String   @unique
  originalName     String
  mimeType         String
  byteSize         BigInt
  width            Int
  height           Int
  sha256           String
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  project UiDesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  renders UiDesignRender[]

  @@index([projectId, viewport, createdAt])
  @@index([createdAt])
}

model UiDesignAnalysis {
  id                   String   @id @default(cuid())
  projectId            String
  status               String   @default("RUNNING")
  version              String   @default("ui-analysis-v1")
  model                String?
  sourceFingerprint    String
  sourceReferencesJson String
  analysisJson         String?
  errorMessage         String?
  createdByUserId      String?
  startedAt            DateTime @default(now())
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project     UiDesignProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generations UiDesignGeneration[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@index([sourceFingerprint])
}

model UiDesignGeneration {
  id                String   @id @default(cuid())
  projectId         String
  sourceAnalysisId  String
  status            String   @default("RUNNING")
  version           String   @default("ui-codegen-v1")
  model             String?
  framework         String
  styling           String
  outputType        String
  sourceFingerprint String
  generationJson    String?
  validationJson    String?
  errorMessage      String?
  parentGenerationId String?
  repairDepth       Int      @default(0)
  aggregateScore    Float?
  viewportScoresJson String?
  qualityStatus     String?
  createdByUserId   String?
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project        UiDesignProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAnalysis UiDesignAnalysis @relation(fields: [sourceAnalysisId], references: [id], onDelete: Cascade)
  renders        UiDesignRender[]
  deliveries     UiDesignDelivery[]

  @@index([projectId, createdAt])
  @@index([sourceAnalysisId])
  @@index([status, createdAt])
  @@index([sourceFingerprint])
  @@index([parentGenerationId])
  @@index([projectId, aggregateScore])
}

model UiDesignRender {
  id                      String   @id @default(cuid())
  projectId               String
  generationId            String
  referenceId             String
  parentRenderId           String?
  viewport                String
  status                  String   @default("PREPARING")
  version                 String   @default("ui-visual-v1")
  width                   Int
  height                  Int
  sourceWidth             Int
  sourceHeight            Int
  sourceScale             Float    @default(1)
  repairDepth             Int      @default(0)
  batchId                 String?
  workerId                String?
  leaseExpiresAt          DateTime?
  heartbeatAt             DateTime?
  attempts                Int      @default(0)
  autoRepair              Boolean  @default(true)
  startedAt               DateTime?
  previewStorageProvider  String?
  previewStorageKey       String?
  previewSha256           String?
  renderedStorageProvider String?
  renderedStorageKey      String?
  diffStorageProvider     String?
  diffStorageKey          String?
  metricsJson             String?
  critiqueJson            String?
  errorMessage            String?
  createdByUserId         String?
  completedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  project    UiDesignProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generation UiDesignGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  reference  UiDesignReference  @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  repairs    UiDesignRepairAttempt[]

  @@index([projectId, createdAt])
  @@index([generationId, createdAt])
  @@index([referenceId])
  @@index([status, createdAt])
  @@index([parentRenderId])
  @@index([batchId])
  @@index([status, leaseExpiresAt])
}

model UiDesignRepairAttempt {
  id                 String   @id @default(cuid())
  projectId          String
  renderId           String
  inputGenerationId  String
  outputGenerationId String
  attemptNumber      Int
  status             String   @default("COMPLETED")
  scoreBefore        Float?
  scoreAfter         Float?
  instructionsJson   String?
  createdByUserId    String?
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project UiDesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  render  UiDesignRender  @relation(fields: [renderId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([renderId])
  @@index([outputGenerationId])
}

model UiDesignAssetBinding {
  id               String   @id @default(cuid())
  projectId        String
  slotName         String
  kind             String
  viewport         String   @default("ALL")
  storageProvider  String
  storageKey       String   @unique
  originalName     String
  mimeType         String
  byteSize         BigInt
  width            Int?
  height           Int?
  sha256           String
  uploadedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project UiDesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slotName, viewport])
  @@index([projectId])
}

model UiDesignIgnoreMask {
  id              String   @id @default(cuid())
  projectId       String
  viewport        String
  label           String
  xPct            Float
  yPct            Float
  widthPct        Float
  heightPct       Float
  enabled         Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project UiDesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, viewport])
}

model UiDesignAgentMessage {
  id              String   @id @default(cuid())
  projectId       String
  role            String
  content         String
  actionJson      String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  project UiDesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model UiDesignDelivery {
  id                    String   @id @default(cuid())
  projectId             String
  generationId          String
  version               String   @default("ui-delivery-v1")
  status                String   @default("READY")
  targetMode            String   @default("EXPORT_ONLY")
  repository            String?
  baseBranch            String?
  targetDirectory       String?
  branchName            String?
  pullRequestNumber     Int?
  pullRequestUrl        String?
  commitSha             String?
  mergeSha              String?
  mappingJson           String   @default("[]")
  regressionJson        String?
  artifactStorageProvider String?
  artifactStorageKey    String?  @unique
  artifactFileName      String?
  artifactByteSize      BigInt?
  artifactSha256        String?
  createdByUserId       String?
  approvedByUserId      String?
  approvedAt            DateTime?
  deploymentTriggeredAt DateTime?
  errorMessage          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project    UiDesignProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generation UiDesignGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([generationId])
  @@index([status, createdAt])
  @@index([repository, pullRequestNumber])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailLog {
