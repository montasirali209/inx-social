{
  "name": "inx-social-cloud-backend",
  "version": "3.4.0",
  "description": "INX Social Cloud platform with browser studio, SMTP email, Stripe subscriptions, Meta Page workspaces, licences and admin controls.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:production": "prisma migrate deploy && node src/server.js",
    "build:frontend": "npm --prefix frontend ci && npm --prefix frontend run build",
    "check:frontend": "npm --prefix frontend run check",
    "check": "node scripts/check-syntax.js && prisma validate && npm run check:frontend",
    "test": "node --require ./test/setup-env.js --test test/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node scripts/seed-admin.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "resend": "^6.17.2",
    "sharp": "0.35.4",
    "stripe": "^18.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "5.22.0"
  }
}
